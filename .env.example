# Server Configuration
API_PORT=8080
WS_MAX_CONNECTIONS=100000

# Database Configuration
DATABASE_URL=postgres://user:pass@postgres:5432/notifications?sslmode=disable

# NATS Configuration
NATS_URL=nats://nats:4222

# Security / Authentication
JWT_SECRET=change-me-in-production-super-secret-key-32-bytes

# Mock Providers Configuration
EMAIL_PROVIDER=mock
SMS_PROVIDER=mock
PUSH_PROVIDER=mock

# Logging
LOG_LEVEL=info
